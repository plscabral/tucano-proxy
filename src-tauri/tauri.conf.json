{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tucano Proxy",
  "version": "0.1.3",
  "identifier": "dev.tucano.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": false,
    "windows": [
      {
        "title": "Tucano Proxy",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true,
        "transparent": false,
        "backgroundColor": "#0F182E",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Open source HTTP/HTTPS debugging proxy",
    "longDescription": "Tucano is an open source desktop debugger for HTTP/HTTPS traffic — capture, inspect, filter and replay requests on Windows and macOS (Intel & Apple Silicon).",
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/plscabral/tucano-proxy/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCRTM1RUJDQUY3MjIxRDMKUldUVElYS3Z2RjdqYTdGZW1nemFqS05Ja2pBS2JIRjg0ZFVxNEkybUdOYWNzcFE5WnZYUHd5YTgK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
