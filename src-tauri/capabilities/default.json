{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for Tucano main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-set-theme",
    "core:window:allow-set-background-color",
    "dialog:default",
    "store:default",
    "updater:default",
    "process:default",
    "process:allow-restart"
  ]
}
